# Node
node_modules/
dist/
build/
pnpm-debug.log*
*.tsbuildinfo

# Expo / React Native
.expo/
android/app/build/
android/.gradle/

# Signing keys
*.keystore
server/keys/

# mkcert-issued local TLS cert/key for Caddy -- regenerated per-machine
# (Caddyfile's own comment has the exact command), never shared/committed
caddy/certs/

# Python
__pycache__/
*.pyc

# Telemetry captures (raw data, not source)
telemetry/data/*.jsonl
telemetry/data/*.png

# Env
.env

# OS
.DS_Store
*.Zone.Identifier

# Claude Code local/session state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Project docs, design notes, analysis and incident/bug writeups -- kept
# local only. This repository is public; these files are not for it.
# CLAUDE.md stays at the repo root (Claude Code only auto-loads it from
# there) but is untracked for the same reason.
docs/
/CLAUDE.md
