POSTGRES_DB=tappay
POSTGRES_USER=tappay
POSTGRES_PASSWORD=tappay
# Host port 5433, not 5432 -- something else on this machine already answers on
# 5432 (surfaced via WSL2 mirrored networking), so docker-compose maps Postgres's
# container port 5432 to host port 5433 to avoid the collision.
DATABASE_URL=postgres://tappay:tappay@localhost:5433/tappay

# The app's own runtime credential, distinct from the schema-owning user
# above -- migration 017 creates a `tappay_app` role with SELECT/INSERT
# only (no UPDATE/DELETE/TRUNCATE) on journal/transfers, so the app can
# never rewrite a settled row even if a bug or a compromised app credential
# tried to. Migrations, seed.ts, and check-invariants keep using
# DATABASE_URL above (they need the owner role); only the app itself uses
# this one. APP_DB_PASSWORD must match what migration 017 was run with --
# see its own comment for why it isn't parameterized like a normal query.
APP_DB_PASSWORD=tappay_app_dev_password
APP_DATABASE_URL=postgres://tappay_app:tappay_app_dev_password@localhost:5433/tappay

SERVER_PORT=3000

# Signs v2 access-token JWTs (server/src/config.ts) -- required, the server
# refuses to start without it, and (as of ADR-0008) also refuses to start if
# it's shorter than 32 characters or still set to the literal placeholder
# below -- a real random value is required even for solo local dev now.
# Generate one with `openssl rand -hex 32` or `node -e
# "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET=dev-only-change-me

# Optional -- see docs/adr/0008-jwt-kid-keyed-rotation.md for the rotation
# runbook these two exist to support. JWT_KID labels the CURRENT signing key
# (defaults to "1"); JWT_PREVIOUS_SECRETS lists prior keys that should still
# verify (never sign) during a rotation's overlap window, as
# `kid:secret,kid:secret`.
# JWT_KID=1
# JWT_PREVIOUS_SECRETS=

# Everything below is optional -- server/src/config.ts's defaults (shown here)
# are used if unset. Documented so they're discoverable; not required for a
# normal dev setup.
# MAX_TRANSFER_MINOR_UNITS=100000000
# SYNC_MAX_INTENTS_PER_BATCH=50
# ENROLLMENT_NONCE_MAX_PENDING=10000
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_ENROLL_MAX=10
# RATE_LIMIT_ENROLL_NONCE_MAX=20
# RATE_LIMIT_TX_SUBMIT_MAX=60
# RATE_LIMIT_TX_SYNC_MAX=30

# Postgres connection pool bounds and query timeouts (server/src/db/kysely.ts).
# See config.ts's own comments for why these defaults are deliberately modest
# rather than maximized.
# DB_POOL_MAX=10
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=3000
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=5000
