{
  "name": "@tappay/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/index.ts",
    "migrate": "dotenv -e ../.env -- node-pg-migrate up",
    "migrate:down": "dotenv -e ../.env -- node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed": "dotenv -e ../.env -- tsx scripts/seed.ts",
    "generate-server-key": "tsx scripts/generate-server-key.ts",
    "check-invariants": "dotenv -e ../.env -- tsx scripts/check-invariants.ts",
    "restore-drill": "dotenv -e ../.env -- tsx scripts/restore-drill.ts",
    "chaos-experiment": "dotenv -e ../.env -- tsx scripts/chaos-experiment.ts",
    "test": "dotenv -e ../.env -- vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@tappay/shared": "workspace:*",
    "asn1js": "^3.0.5",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "kysely": "^0.28.17",
    "pg": "^8.13.1",
    "pkijs": "^3.2.4",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "dotenv-cli": "^11.0.0",
    "fast-check": "^4.9.0",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vitest": "^3.0.5"
  }
}
