<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- M3 Milestone 1: permissions plus the service declaration for the
       connection-holding BLE service Android 14+ requires a typed
       foreground service for (CLAUDE.md §5). The service itself
       (BleTransportService.kt) is a compiling but functionally inert
       scaffold; nothing starts it yet, see its own doc comment. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

  <application>
    <service
      android:name="expo.modules.tappay.ble.BleTransportService"
      android:foregroundServiceType="connectedDevice"
      android:exported="false" />

    <!-- NFC-2: "Share via NFC" HCE service. android:exported="true" is
         required by the platform for HOST_APDU_SERVICE (the NFC subsystem,
         a different app process, is what actually invokes it), but
         android:permission=BIND_NFC_SERVICE means only the system itself
         (holder of that permission) can bind to it: the same
         narrow-but-necessarily-exported shape as any HCE service. -->
    <service
      android:name="expo.modules.tappay.nfc.NfcHceService"
      android:exported="true"
      android:permission="android.permission.BIND_NFC_SERVICE">
      <intent-filter>
        <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
      </intent-filter>
      <meta-data
        android:name="android.nfc.cardemulation.host_apdu_service"
        android:resource="@xml/apduservice" />
    </service>
  </application>
</manifest>
