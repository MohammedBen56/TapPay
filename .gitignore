*.pyc

# Telemetry captures (raw data, not source)
telemetry/data/*.jsonl
telemetry/data/*.png

# Env
.env

# OS
.DS_Store
*.Zone.Identifier

# Claude Code local/session state
.claude/settings.local.json
.claude/scheduled_tasks.lock
