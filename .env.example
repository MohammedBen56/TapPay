POSTGRES_DB=tappay
POSTGRES_USER=tappay
POSTGRES_PASSWORD=tappay
# Host port 5433, not 5432 -- something else on this machine already answers on
# 5432 (surfaced via WSL2 mirrored networking), so docker-compose maps Postgres's
# container port 5432 to host port 5433 to avoid the collision.
DATABASE_URL=postgres://tappay:tappay@localhost:5433/tappay

SERVER_PORT=3000
